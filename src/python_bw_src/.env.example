# Copy to .env and fill in real values.  .env is gitignored — never commit it.

# Path where uploaded JPEGs are saved
JPG_FOLDER_PATH=/path/to/jpg/folder

# PostgreSQL connection (birdwatch database on the BirdWatch server)
DB_HOST=192.168.1.110
DB_PORT=5432
DB_NAME=birdwatch
DB_USERNAME=birdwatch
DB_PASSWORD=your_password_here
