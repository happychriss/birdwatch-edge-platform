src/python_bw_src/jpg_folder/*.jpg
src/python_bw_src/jpg_folder/*.jpeg
src/python_bw_src/jpg_folder/*.png
src/python_bw_src/datasets/**/*.jpg
src/python_bw_src/datasets/**/*.jpeg
src/python_bw_src/datasets/**/*.png
